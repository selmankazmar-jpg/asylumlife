local SAState = getgenv().__AsylumSilentAimState

local InternalRaycastDepth = 0
local wallCheckParams = RaycastParams.new()
wallCheckParams.FilterType = Enum.RaycastFilterType.Exclude
wallCheckParams.IgnoreWater = true

local lastFilterChar = nil
local lastFilterCam  = nil

local function SafeRaycast(origin, direction, rp)
    InternalRaycastDepth = InternalRaycastDepth + 1
    local ok, result = pcall(Workspace.Raycast, Workspace, origin, direction, rp)
    InternalRaycastDepth = InternalRaycastDepth > 0 and (InternalRaycastDepth - 1) or 0
    if ok then return result end
    return nil
end

local function IsPlayerVisibleFast(targetPart, targetChar, originPos)
    if not (targetPart and targetPart.Parent) then return false end
    local char = LocalPlayer.Character
    local cam = Workspace.CurrentCamera
    if not cam then return false end

    local origin = originPos or cam.CFrame.Position
    local partPos = targetPart.Position
    local direction = partPos - origin

    if lastFilterChar ~= char or lastFilterCam ~= cam then
        lastFilterChar = char
        lastFilterCam = cam
        wallCheckParams.FilterDescendantsInstances = { char, cam }
    end

    local result = SafeRaycast(origin, direction, wallCheckParams)
    if not result then return true end

    local hit = result.Instance
    return hit and (hit:IsDescendantOf(targetChar) or hit == targetPart)
end

local function GetAimDirection(origin, targetPos)
    return (targetPos - origin).Unit * 9999
end

local function UpdateSilentAimTarget()
    if not Settings.SilentAimEnabled then
        SAState.CurrentTarget = nil
        if UI.updateSilentAimStatus then
            UI.updateSilentAimStatus("Silent Aim is Disabled", false, false)
        end
        return
    end

    local myChar = LocalPlayer.Character
    local activeTool = myChar and (
        myChar:FindFirstChild("Taser") or 
        myChar:FindFirstChild("Handheld Taser") or 
        myChar:FindFirstChild("Peppergun") or 
        myChar:FindFirstChild("Ignotus Laser Pistol")
    )
    if not activeTool then
        SAState.CurrentTarget = nil
        if UI.updateSilentAimStatus then
            UI.updateSilentAimStatus("Waiting for Taser / Ranged tool...", false, true)
        end
        return
    end

    local Camera = Workspace.CurrentCamera
    if not Camera then
        SAState.CurrentTarget = nil
        return
    end

    local camCFrame = Camera.CFrame
    local camPos    = camCFrame.Position
    local camLook   = camCFrame.LookVector
    local mousePos  = UserInputService:GetMouseLocation()

    local closestDistSq = math.huge
    local bestTarget = nil
    local bestPlayerName = nil

    local doWallCheck = Settings.SilentAimWallCheck and not Settings.Wallbang

    local playersList = Players:GetPlayers()
    for i = 1, #playersList do
        local player = playersList[i]
        if player ~= LocalPlayer then
            -- 1. Must be on team named "PATIENT" or "PATIENTS"
            local pTeam = player.Team
            local pTeamName = pTeam and pTeam.Name or ""
            if pTeamName == "PATIENT" or pTeamName == "PATIENTS" then
                local char = player.Character
                -- 2. Attribute checks: IsTagged must be true, Ragdolled must NOT be true
                local isTagged = player:GetAttribute("IsTagged")
                if isTagged == nil and char then
                    isTagged = char:GetAttribute("IsTagged")
                end

                if isTagged == true then
                    local isRagdolled = player:GetAttribute("Ragdolled")
                    if isRagdolled == nil and char then
                        isRagdolled = char:GetAttribute("Ragdolled")
                    end

                    if isRagdolled ~= true then
                        if char then
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                                if part then
                                    local partPos = part.Position

                                    -- Frustum / screen projection
                                    local screenPos, onScreen = Camera:WorldToScreenPoint(partPos)
                                    local distSq

                                    if onScreen then
                                        local dx = screenPos.X - mousePos.X
                                        local dy = screenPos.Y - mousePos.Y
                                        distSq = dx * dx + dy * dy
                                    else
                                        -- If off-screen or behind camera, compute 3D world distance relative to camera forward vector
                                        local toPart = (partPos - camPos)
                                        distSq = 1000000 + toPart.Magnitude * 1000
                                    end

                                    if distSq < closestDistSq then
                                        if not doWallCheck or IsPlayerVisibleFast(part, char, camPos) then
                                            closestDistSq = distSq
                                            bestTarget = part
                                            bestPlayerName = player.DisplayName or player.Name
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    SAState.CurrentTarget = bestTarget
    if UI.updateSilentAimStatus then
        if bestTarget then
            local modeText = Settings.Wallbang and " [WALLBANG]" or ""
            UI.updateSilentAimStatus(string.format("Locked: %s (Head)%s", bestPlayerName or "Patient", modeText), true, false)
        else
            UI.updateSilentAimStatus(Settings.Wallbang and "Wallbang Active: Scanning Tagged Patients..." or "Searching for Tagged Patients...", false, false)
        end
    end
end

