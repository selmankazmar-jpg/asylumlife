-- WINDOW DRAGGING, DYNAMIC RESIZING & MOBILE CONTROLS
-- ============================================================================
local isMinimized = false

local function applyResponsiveMainFrameSize()
    local targetW, targetH, targetScale = computeResponsiveDimensions()
    curWidth = targetW
    curHeight = targetH
    curScale = targetScale

    if MainScale then
        MainScale.Scale = curScale
    end

    if isMinimized then
        MainFrame.Size = UDim2.new(0, curWidth, 0, 50)
    else
        MainFrame.Size = UDim2.new(0, curWidth, 0, curHeight)
    end

    -- Viewport boundary safety check
    local vp = getActiveViewportSize()
    local scaledW = curWidth * curScale
    local scaledH = (isMinimized and 50 or curHeight) * curScale
    local maxPosX = math.max(0, vp.X - scaledW)
    local maxPosY = math.max(0, vp.Y - scaledH)
    local currentAbsPos = MainFrame.AbsolutePosition

    if currentAbsPos.X > maxPosX or currentAbsPos.Y > maxPosY or currentAbsPos.X < 0 or currentAbsPos.Y < 0 then
        local clampedX = math.clamp(currentAbsPos.X, 0, maxPosX)
        local clampedY = math.clamp(currentAbsPos.Y, 0, maxPosY)
        MainFrame.Position = UDim2.new(0, clampedX, 0, clampedY)
    end
end

