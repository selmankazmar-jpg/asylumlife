local function saveConfigFile(name)
    if not hasFileSystem then return false, "No filesystem support" end
    if not name or #name == 0 then return false, "Enter a config name" end
    local cleanName = string.gsub(name, "[^%w_%-]", "")
    if #cleanName == 0 then return false, "Invalid characters in name" end

    initFileSystem()
    local filePath = FOLDER_NAME .. "/" .. cleanName .. ".json"
    local raw = HttpService:JSONEncode(serializeCurrentSettings())
    local ok, err = pcall(function()
        writefile(filePath, raw)
    end)
    return ok, ok and cleanName or err
end

local function loadConfigFile(name)
    if not hasFileSystem then return false, "No filesystem support" end
    if not name or #name == 0 then return false, "Enter a config name" end
    local cleanName = string.gsub(name, "[^%w_%-]", "")
    local filePath = FOLDER_NAME .. "/" .. cleanName .. ".json"

    local ok, content = pcall(function()
        return readfile(filePath)
    end)
    if not ok or not content then return false, "File not found" end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not decodeOk or typeof(data) ~= "table" then return false, "Corrupted config" end

    applyLoadedSettings(data)
    return true, cleanName
end

local function deleteConfigFile(name)
    if not hasFileSystem then return false, "No filesystem support" end
    if not name or #name == 0 then return false, "Enter a config name" end
    local cleanName = string.gsub(name, "[^%w_%-]", "")
    local filePath = FOLDER_NAME .. "/" .. cleanName .. ".json"

    local ok, err = pcall(function()
        if typeof(isfile) == "function" and isfile(filePath) then
            if typeof(delfile) == "function" then
                delfile(filePath)
            end
        end
        local currentAuto = getAutoloadConfig()
        if currentAuto == cleanName then
            setAutoloadConfig(nil)
        end
    end)
    return ok, ok and cleanName or err
end

-- ============================================================================
-- NOCLIP ENGINE
-- ============================================================================
local NoclipConn = nil
local ClipState = true
local floatName = "FloatPart"

local function startNoclip()
    ClipState = false
    if NoclipConn then
        pcall(function() NoclipConn:Disconnect() end)
        NoclipConn = nil
    end
    local function Nocl()
        if ClipState == false and LocalPlayer.Character ~= nil then
            for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA('BasePart') and v.CanCollide and v.Name ~= floatName then
                    v.CanCollide = false
                end
            end
        end
    end
    NoclipConn = RunService.Stepped:Connect(Nocl)
end

local function stopNoclip()
    ClipState = true
    if NoclipConn then
        pcall(function() NoclipConn:Disconnect() end)
        NoclipConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= floatName then
                if v.Name == "Torso" or v.Name == "UpperTorso" or v.Name == "LowerTorso" or v.Name == "Head" then
                    v.CanCollide = true
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end
end

setNoclipState = function(enabled)
    Settings.NoclipEnabled = enabled
    if enabled then
        startNoclip()
    else
        stopNoclip()
    end
    if UI.updateNoclipIndicator then
        UI.updateNoclipIndicator(enabled)
    end
    if UI.Noclip and UI.Noclip.SetToggle then
        UI.Noclip.SetToggle(enabled)
    end
end

