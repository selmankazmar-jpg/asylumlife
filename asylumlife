local COLOR_TRASHCAN_READY_FILL = Color3.fromRGB(34, 197, 94)    -- Green
local COLOR_TRASHCAN_READY_OUT = Color3.fromRGB(74, 222, 128)
local COLOR_TRASHCAN_CHECKED_FILL = Color3.fromRGB(239, 68, 68)  -- Red
local COLOR_TRASHCAN_CHECKED_OUT = Color3.fromRGB(248, 113, 113)

local function removeTrashCanESP(model)
    local data = TrashCanESPObjects[model]
    if data then
        if data.Highlight and data.Highlight.Parent then
            pcall(function() data.Highlight:Destroy() end)
        end
        TrashCanESPObjects[model] = nil
    end
end

local function createTrashCanESP(model)
    if not (model and model.Parent) then return end
    removeTrashCanESP(model)

    local targetPart = model:FindFirstChild("Base") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not targetPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "_TrashCanHighlight"
    highlight.Adornee = model
    highlight.FillColor = COLOR_TRASHCAN_READY_FILL
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = COLOR_TRASHCAN_READY_OUT
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = Settings.TrashCanESP
    highlight.Parent = model

    TrashCanESPObjects[model] = {
        Highlight = highlight,
        Model = model,
        Part = targetPart,
        IsChecked = false,
        Sequence = 0,
    }
end

local function applyTrashCanCheckedVisual(model, base, duration)
    if not (model and model.Parent) then return end
    local data = TrashCanESPObjects[model]
    if not (data and data.Highlight and data.Highlight.Parent) then
        createTrashCanESP(model)
        data = TrashCanESPObjects[model]
    end

    if data and data.Highlight then
        data.IsChecked = true
        data.Highlight.FillColor = COLOR_TRASHCAN_CHECKED_FILL
        data.Highlight.OutlineColor = COLOR_TRASHCAN_CHECKED_OUT
        data.Highlight.Enabled = Settings.TrashCanESP

        local seq = (data.Sequence or 0) + 1
        data.Sequence = seq

        task.delay(duration or PROMPT_COOLDOWN, function()
            local curData = TrashCanESPObjects[model]
            if curData and curData.Sequence == seq and curData.Highlight and curData.Highlight.Parent then
                curData.IsChecked = false
                curData.Highlight.FillColor = COLOR_TRASHCAN_READY_FILL
                curData.Highlight.OutlineColor = COLOR_TRASHCAN_READY_OUT
                curData.Highlight.Enabled = Settings.TrashCanESP
            end
        end)
    end
end

