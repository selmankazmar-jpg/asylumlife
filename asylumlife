local function onSaveClicked()
    local name = configNameInputBox.Text
    local ok, res = saveConfigFile(name)
    if ok then
        setConfigStatus(string.format("[✓] Saved config '%s' successfully!", res), false)
        if refreshConfigListUI then refreshConfigListUI() end
    else
        setConfigStatus(string.format("[!] Save failed: %s", tostring(res)), true)
    end
end

local function onLoadClicked()
    local name = configNameInputBox.Text
    local ok, res = loadConfigFile(name)
    if ok then
        setConfigStatus(string.format("[✓] Loaded config '%s' successfully!", res), false)
        if refreshConfigListUI then refreshConfigListUI() end
    else
        setConfigStatus(string.format("[!] Load failed: %s", tostring(res)), true)
    end
end

local function onDeleteClicked()
    local name = configNameInputBox.Text
    local ok, res = deleteConfigFile(name)
    if ok then
        setConfigStatus(string.format("[✓] Deleted config '%s'.", res), false)
        if refreshConfigListUI then refreshConfigListUI() end
        if updateAutoloadVisual then updateAutoloadVisual() end
    else
        setConfigStatus(string.format("[!] Delete failed: %s", tostring(res)), true)
