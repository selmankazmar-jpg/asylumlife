local isHoldingClick = false
local isHoldingTouch = false
local isMouseOverMenu = false

local function getEquippedTool()
    local character = LocalPlayer.Character
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end
    return nil
end

local function isOverOurMenu()
    if UserInputService:GetFocusedTextBox() then return true end
    if isMouseOverMenu then return true end

    local ok, isInside = pcall(function()
        local gui = getGuiContainer():FindFirstChild(GUI_NAME)
        if not gui then return false end
        local mainFrame = gui:FindFirstChild("MainFrame")
        if mainFrame and mainFrame.Visible then
            local mPos = UserInputService:GetMouseLocation()
            local fPos = mainFrame.AbsolutePosition
            local fSize = mainFrame.AbsoluteSize
            if mPos.X >= fPos.X and mPos.X <= (fPos.X + fSize.X) and
               mPos.Y >= fPos.Y and mPos.Y <= (fPos.Y + fSize.Y) then
                return true
            end
        end
        return false
    end)
    return (ok and isInside) and true or false
end

-- Dedicated Auto-Click Worker Thread (Direct tool:Activate() spam)
local autoClickRunning = true
task.spawn(function()
    while autoClickRunning do
        task.wait(0.04)
        if Settings.AutoClicker then
            local isMouseDown = false
            pcall(function()
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    isMouseDown = true
                end
            end)
            if not isMouseDown and not UserInputService.TouchEnabled then
                isHoldingClick = false
            end

            local activeHold = (isHoldingClick or (isMouseDown and not isMouseOverMenu) or isHoldingTouch)

            if activeHold and not isOverOurMenu() then
                local tool = getEquippedTool()
                if tool then
                    pcall(function()
                        tool:Activate()
                    end)
                end
            end
        end
    end
end)

local function onCharacterAdded(character)
    isMacroHolding = false
    SprintToggleState_Macro = false
    isHoldingClick = false
    isHoldingTouch = false
    task.spawn(function()
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end)
    end)
    if Settings.NoclipEnabled then
        startNoclip()
    end
end

if LocalPlayer.Character then
    task.spawn(onCharacterAdded, LocalPlayer.Character)
end
