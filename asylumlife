local function detectExecutorName()
    local ok, res = pcall(function()
        if typeof(identifyexecutor) == "function" then
            local name, version = identifyexecutor()
            if version and #tostring(version) > 0 then
                return string.format("%s (v%s)", tostring(name), tostring(version))
            end
            return tostring(name)
        elseif typeof(getexecutorname) == "function" then
            return tostring(getexecutorname())
        elseif typeof(syn) == "table" then
            return "Synapse X"
        elseif typeof(KRNL_LOADED) ~= "undefined" and KRNL_LOADED then
            return "Krnl"
        elseif typeof(fluxus) == "table" then
            return "Fluxus"
        elseif typeof(is_sirhurt_closure) == "function" then
            return "SirHurt"
        elseif typeof(SENTINEL_LOADED) ~= "undefined" and SENTINEL_LOADED then
            return "Sentinel"
        elseif typeof(PROTOSMASHER_LOADED) ~= "undefined" and PROTOSMASHER_LOADED then
            return "ProtoSmasher"
        elseif typeof(shadow_env) == "table" then
            return "Shadow"
        end
        return "Unknown Executor"
    end)
    return (ok and res) and res or "Unknown Executor"
end

local currentExecutor = detectExecutorName()
local execLower = string.lower(currentExecutor)
if string.find(execLower, "jjsploit", 1, true) or string.find(execLower, "xeno", 1, true) then
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Execution Blocked",
            Text = string.format("Your executor (%s) cannot run this script due to lack of required environment support.", currentExecutor),
            Duration = 10,
        })
    end)
    warn(string.format("[Asylum Life] Execution blocked: Your executor (%s) cannot run this script.", currentExecutor))
    return
end

