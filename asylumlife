-- ============================================================================
-- MAIN ENGINE LOOP (HEARTBEAT)
-- ============================================================================
RunService.Heartbeat:Connect(function(dt)
    -- 0. Infinite Stamina Maintenance
    if Settings.InfiniteStamina and MovementShared then
        MovementShared.SPRINT_MINIMUM_ENERGY = 0
        pcall(function()
            if typeof(MovementShared.setPlayerEnergy) == "function" then
                MovementShared.setPlayerEnergy(100)
            end
        end)
    end

    -- 1. CFrame Speed Boost (Additive movement offset without touching WalkSpeed)
    if Settings.SpeedEnabled and Settings.SpeedAmount > 0 then
        local character = LocalPlayer.Character
        local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if rootPart and humanoid and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0 then
            local moveDir = humanoid.MoveDirection
            rootPart.CFrame = rootPart.CFrame + (moveDir * (Settings.SpeedAmount * dt))
        end
    end

    local character = LocalPlayer.Character
    local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
    local rootPos = rootPart and rootPart.Position
    local rX = rootPos and rootPos.X or 0
    local rY = rootPos and rootPos.Y or 0
    local rZ = rootPos and rootPos.Z or 0

    local now = os.clock()

    if (now - (lastTopBarStatsUpdate or 0)) >= 0.5 then
        lastTopBarStatsUpdate = now
        if UI.updateTopBarStats then
            pcall(UI.updateTopBarStats)
        end
    end

    -- 2. TrashCan Collector Engine
    local currentTrashCount = 0
    for base, data in pairs(TrashCanCache) do
        if not (base and base.Parent and data.Prompt and data.Prompt.Parent) then
            TrashCanCache[base] = nil
        else
            currentTrashCount = currentTrashCount + 1
        end
    end
    if UI.CacheStatusLabel then
        UI.CacheStatusLabel.Text = string.format("Cached TrashCans: %d  •  Async Engine Ready", currentTrashCount)
    end

    if Settings.TrashCollector and rootPart then
        for base, data in pairs(TrashCanCache) do
            if (now - (data.LastFired or 0)) >= PROMPT_COOLDOWN then
                local bPos = base.Position
                local dX = bPos.X - rX
                local dY = bPos.Y - rY
                local dZ = bPos.Z - rZ
                local distSq = dX * dX + dY * dY + dZ * dZ
                if distSq <= DETECTION_RADIUS_SQ then
                    if firePrompt(data.Prompt) then
                        data.LastFired = now
                        task.spawn(applyTrashCanCheckedVisual, data.Model, base, PROMPT_COOLDOWN)
                    end
                end
            end
        end
    end

    -- 3. Dropped Tools Auto-Pickup Loop
    if Settings.AutoPickTools and rootPart then
        local canPick = true
        if Settings.AutoPickToolsPatientOnly then
            local myTeam = LocalPlayer.Team
            local myTeamName = myTeam and myTeam.Name or ""
            canPick = (myTeamName == "PATIENT" or myTeamName == "PATIENTS")
        end
        if canPick then
            local DROPPED_TOOL_COOLDOWN = 1.0
            for model, data in pairs(DroppedToolCache) do
                if (now - (data.LastFired or 0)) >= DROPPED_TOOL_COOLDOWN then
                    if data.Prompt and data.Prompt.Parent and data.Handle and data.Handle.Parent then
                        local hPos = data.Handle.Position
                        local dX = hPos.X - rX
                        local dY = hPos.Y - rY
                        local dZ = hPos.Z - rZ
                        local distSq = dX * dX + dY * dY + dZ * dZ
                        local maxPickDistSq = (data.Prompt.MaxActivationDistance or 10) * (data.Prompt.MaxActivationDistance or 10)
                        if distSq <= maxPickDistSq then
                            if firePrompt(data.Prompt) then
                                data.LastFired = now
                            end
                        end
                    else
                        DroppedToolCache[model] = nil
                    end
                end
            end
        end
    end

    -- 4. Auto Open Door Loop
    if Settings.AutoOpenDoor and rootPart then
        local AUTO_DOOR_COOLDOWN = 1.0
        for prompt, data in pairs(DoorPromptCache) do
            if not (prompt and prompt.Parent and data.Part and data.Part.Parent) then
                DoorPromptCache[prompt] = nil
            else
                if (now - (data.LastFired or 0)) >= AUTO_DOOR_COOLDOWN then
                    local pPos = data.Part.Position
                    local dX = pPos.X - rX
                    local dY = pPos.Y - rY
                    local dZ = pPos.Z - rZ
                    local distSq = dX * dX + dY * dY + dZ * dZ
                    local maxDist = prompt.MaxActivationDistance or 10
                    local maxDistSq = maxDist * maxDist
                    if distSq <= maxDistSq then
                        if firePrompt(prompt) then
                            data.LastFired = now
                        end
                    end
                end
            end
        end
    end

    -- 5. Auto Arrest Engine (Frame-accurate Stunned Patient check & prompt fire)
    local hasArrestTool = character and (character:FindFirstChild("Box") or character:FindFirstChild("Arrest") or character:FindFirstChild("Handcuffs"))
    if UI.AutoArrest and UI.AutoArrest.SetDesc then
        if hasArrestTool then
            UI.AutoArrest.SetDesc("Arrest Tool: [ Equipped ]")
        else
            UI.AutoArrest.SetDesc("Arrest Tool: [ Not Equipped ]")
        end
    end

    if Settings.AutoArrest and rootPart then
        local myTeam = LocalPlayer.Team
        local myTeamName = myTeam and myTeam.Name or ""
        local isLocalPatient = (myTeamName == "PATIENT" or myTeamName == "PATIENTS")

        if not isLocalPatient and hasArrestTool then
            local charactersFolder = Workspace:FindFirstChild("Characters")
            local playersList = Players:GetPlayers()
            for i = 1, #playersList do
                local pl = playersList[i]
                if pl ~= LocalPlayer then
                    local targetChar = pl.Character or (charactersFolder and charactersFolder:FindFirstChild(pl.Name))
                    if targetChar and targetChar.Parent then
                        -- Check Stunned attribute on Player or Character Model
                        local isStunned = pl:GetAttribute("Stunned")
                        if isStunned == nil then
                            isStunned = targetChar:GetAttribute("Stunned")
                        end

                        if isStunned == true then
                            local tRoot = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
                            if tRoot then
                                local prompt = tRoot:FindFirstChildOfClass("ProximityPrompt") or targetChar:FindFirstChildOfClass("ProximityPrompt")
                                if prompt and prompt.Enabled then
                                    local tPos = tRoot.Position
                                    local dX = tPos.X - rX
                                    local dY = tPos.Y - rY
                                    local dZ = tPos.Z - rZ
                                    local distSq = dX * dX + dY * dY + dZ * dZ
                                    local maxDist = prompt.MaxActivationDistance or 10
                                    local maxDistSq = maxDist * maxDist
                                    if distSq <= maxDistSq then
                                        firePrompt(prompt)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

