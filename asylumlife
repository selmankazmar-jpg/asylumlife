-- REACH & MELEE TEAM-FILTER INTERCEPTOR
-- Rules:
-- If LocalPlayer is in "PATIENT" / "PATIENTS", can hit ANY player.
-- Otherwise, can ONLY hit players on "PATIENT" / "PATIENTS" team.
-- ============================================================================
local function isTargetEligibleForMelee(targetModel)
    if not targetModel then return false end
    if targetModel == LocalPlayer.Character then return false end
    if targetModel.Name == LocalPlayer.Name then return false end
    local targetPlayer = Players:GetPlayerFromCharacter(targetModel) or Players:FindFirstChild(targetModel.Name)
    if targetPlayer and targetPlayer == LocalPlayer then return false end

    local myTeam = LocalPlayer.Team
    local myTeamName = myTeam and myTeam.Name or ""
    local isLocalPatient = (myTeamName == "PATIENT" or myTeamName == "PATIENTS")

    if isLocalPatient then
        return true
    end

    local targetTeam = targetPlayer and targetPlayer.Team
    local targetTeamName = targetTeam and targetTeam.Name or ""
    return (targetTeamName == "PATIENT" or targetTeamName == "PATIENTS")
end

local function getClosestEligibleMeleeTarget(originPos, maxDistance)
    local closestPart = nil
    local closestHum = nil
    local closestDist = maxDistance or Settings.ReachDistance

    local charactersFolder = Workspace:FindFirstChild("Characters")
    local playersList = Players:GetPlayers()

    for i = 1, #playersList do
        local pl = playersList[i]
        if pl ~= LocalPlayer then
            local char = pl.Character or (charactersFolder and charactersFolder:FindFirstChild(pl.Name))
            if char and isTargetEligibleForMelee(char) then
                local tHum = char:FindFirstChildOfClass("Humanoid")
                if tHum and tHum.Health > 0 then
                    local tPart = char:FindFirstChild("Head") 
                        or char:FindFirstChild("HumanoidRootPart") 
                        or char:FindFirstChild("Torso") 
                        or char:FindFirstChild("UpperTorso")
                    if tPart then
                        local dist = (tPart.Position - originPos).Magnitude
                        if dist <= closestDist then
                            closestDist = dist
                            closestPart = tPart
                            closestHum = tHum
                        end
                    end
                end
            end
        end
    end

    return closestPart, closestHum
end

local function processMeleeRayHit(hitboxCaster, rayResult)
    if not (hitboxCaster and rayResult and rayResult.Instance) then return end
    local hitInst = rayResult.Instance
    local hitsTable = hitboxCaster._Cache and hitboxCaster._Cache.Hits

    if hitsTable and not hitsTable[hitInst] then
        local targetModel = hitInst:FindFirstAncestorOfClass("Model")
        local targetHum = nil
        if targetModel then
            if not targetModel:HasTag("Drone") then
                targetHum = targetModel:FindFirstChildOfClass("Humanoid")
            end
        else
            targetHum = nil
        end

        if hitboxCaster.OnHit then
            hitboxCaster.OnHit:Fire(hitInst, targetHum, rayResult)
        end
        hitsTable[hitInst] = true
    end
end

