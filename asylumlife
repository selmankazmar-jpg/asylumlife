local function cleanModelConnections(model)
    local conns = ModelConnections[model]
    if conns then
        for i = 1, #conns do
            local c = conns[i]
            if c and c.Connected then
                pcall(function() c:Disconnect() end)
            end
        end
        ModelConnections[model] = nil
    end
end

local function bindBasePrompt(base, model)
    if not (base and base:IsA("BasePart") and base.Name == "Base") then return end

    local function evalPrompt(prompt)
        if prompt and prompt:IsA("ProximityPrompt") then
            TrashCanCache[base] = {
                Prompt = prompt,
                Model = model,
                LastFired = 0,
            }
        end
    end

    local existingPrompt = base:FindFirstChildOfClass("ProximityPrompt")
    if existingPrompt then
        evalPrompt(existingPrompt)
    end

    ModelConnections[model] = ModelConnections[model] or {}
    table.insert(ModelConnections[model], base.ChildAdded:Connect(function(child)
        task.spawn(evalPrompt, child)
    end))

    table.insert(ModelConnections[model], base.ChildRemoved:Connect(function(child)
        if child:IsA("ProximityPrompt") and TrashCanCache[base] and TrashCanCache[base].Prompt == child then
            TrashCanCache[base] = nil
        end
    end))
end

local function registerTrashCan(model)
    if not (model and model:IsA("Model") and model.Name == "TrashCan") then return end
    if ModelConnections[model] then return end

    ModelConnections[model] = {}

    local existingBase = model:FindFirstChild("Base")
    if existingBase then
        task.spawn(bindBasePrompt, existingBase, model)
    end

    task.spawn(createTrashCanESP, model)

    table.insert(ModelConnections[model], model.ChildAdded:Connect(function(child)
        if child.Name == "Base" then
            task.spawn(bindBasePrompt, child, model)
            task.spawn(createTrashCanESP, model)
        end
    end))

    table.insert(ModelConnections[model], model.ChildRemoved:Connect(function(child)
        if child.Name == "Base" and TrashCanCache[child] then
            TrashCanCache[child] = nil
        end
    end))

    table.insert(ModelConnections[model], model.Destroying:Connect(function()
        for base, data in pairs(TrashCanCache) do
            if data.Model == model then
                TrashCanCache[base] = nil
            end
        end
        removeTrashCanESP(model)
        cleanModelConnections(model)
    end))
end

