UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if activeKeyRebindTarget then
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            local cb = onKeyReboundCallback
            activeKeyRebindTarget = nil
            onKeyReboundCallback = nil
            if cb then
                task.spawn(cb, input.KeyCode)
            end
            return
        end
    end

    -- Track mouse / touch holding as long as not clicking inside UI
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if not gameProcessed and not isOverOurMenu() then
            isHoldingClick = true
        end
    elseif input.UserInputType == Enum.UserInputType.Touch then
        if not gameProcessed and not isOverOurMenu() then
            isHoldingTouch = true
        end
    end

    if gameProcessed then return end

    if input.KeyCode == Settings.ToggleKey then
        local gui = getGuiContainer():FindFirstChild(GUI_NAME)
        if gui then
            local frame = gui:FindFirstChild("MainFrame")
            if frame then
                frame.Visible = not frame.Visible
            end
        end
        return
    end

    if Settings.SpeedKey and Settings.SpeedKey ~= Enum.KeyCode.Unknown and input.KeyCode == Settings.SpeedKey then
        Settings.SpeedEnabled = not Settings.SpeedEnabled
        if UI.Speed and UI.Speed.SetToggle then
            UI.Speed.SetToggle(Settings.SpeedEnabled)
        end
        return
    end

    if Settings.NoclipKey and Settings.NoclipKey ~= Enum.KeyCode.Unknown and input.KeyCode == Settings.NoclipKey then
        setNoclipState(not Settings.NoclipEnabled)
        return
    end

    if input.KeyCode == Enum.KeyCode.LeftShift then
        isMacroHolding = false
    end
