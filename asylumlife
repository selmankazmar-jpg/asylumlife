getgenv().__AsylumCleanup = function()
    if saRenderConn and saRenderConn.Connected then
        pcall(function() saRenderConn:Disconnect() end)
    end
    if espRenderConn and espRenderConn.Connected then
        pcall(function() espRenderConn:Disconnect() end)
    end
    pcall(function() stopNoclip() end)
    if Settings.RemoveDoors then
        pcall(function() setRemoveDoors(false) end)
    end
    autoClickRunning = false
    isUserHolding = false
    table.clear(DoorPromptCache)
    for pl, data in pairs(PlayerESPObjects) do
        if data.Billboard and data.Billboard.Parent then
            pcall(function() data.Billboard:Destroy() end)
        end
    end
    table.clear(PlayerESPObjects)
    for model, data in pairs(TrashCanESPObjects) do
        if data.Highlight and data.Highlight.Parent then
            pcall(function() data.Highlight:Destroy() end)
        end
    end
    table.clear(TrashCanESPObjects)
    for model, data in pairs(DroppedToolESPObjects) do
        if data.Highlight and data.Highlight.Parent then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard and data.Billboard.Parent then pcall(function() data.Billboard:Destroy() end) end
    end
    table.clear(DroppedToolESPObjects)
    table.clear(DroppedToolCache)
    for model, conns in pairs(DroppedToolConnections) do
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end
    table.clear(DroppedToolConnections)
end
