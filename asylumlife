local TARGET_SEARCH_PHRASES = {
    "Perhaps you should wait before searching again.",
    "You couldn't find anything in here.",
    "You're too far.",
    "You already have this item.",
    "Your target is out of reach.",
}

local function isSearchPopupText(str)
    if typeof(str) ~= "string" or #str == 0 then return false end
    for i = 1, #TARGET_SEARCH_PHRASES do
        local phrase = TARGET_SEARCH_PHRASES[i]
        if str == phrase or string.find(str, phrase, 1, true) then
            return true
        end
    end
    local sLower = string.lower(str)
    if string.find(sLower, "wait before searching again", 1, true)
       or string.find(sLower, "couldn't find anything in here", 1, true)
       or string.find(sLower, "couldnt find anything in here", 1, true)
       or string.find(sLower, "too far", 1, true)
       or string.find(sLower, "already have this item", 1, true)
       or string.find(sLower, "out of reach", 1, true) then
        return true
    end
    return false
end

local function checkAndPurgePopupBody(body)
    if not (body and body.Parent and body.Name == "Body") then return false end
    if not Settings.DeleteSearchMessages then return false end

    local text = ""
    local ok, propVal = pcall(function() return body.Text end)
    if ok and typeof(propVal) == "string" then
        text = propVal
    end

    if #text == 0 then
        local attrVal = body:GetAttribute("Text")
        if typeof(attrVal) == "string" then
            text = attrVal
        end
    end

    if isSearchPopupText(text) then
        pcall(function()
            if body.Parent and body.Parent.Name == "MessageBox" then
                body.Parent:Destroy()
            else
                body:Destroy()
            end
        end)
        return true
    end
    return false
end

local function monitorPopupBody(body)
    if not (body and body:IsA("Instance") and body.Name == "Body") then return end

    if checkAndPurgePopupBody(body) then return end

    local textConn = nil
    if body:IsA("TextLabel") or body:IsA("TextButton") or body:IsA("TextBox") then
        local ok, sig = pcall(function()
            return body:GetPropertyChangedSignal("Text")
        end)
        if ok and sig then
            textConn = sig:Connect(function()
                if checkAndPurgePopupBody(body) then
                    if textConn and textConn.Connected then textConn:Disconnect() end
                end
            end)
        end
    end

    local attrConn = nil
    pcall(function()
        attrConn = body.AttributeChanged:Connect(function(attr)
            if attr == "Text" and checkAndPurgePopupBody(body) then
                if attrConn and attrConn.Connected then attrConn:Disconnect() end
            end
        end)
    end)

    pcall(function()
        body.Destroying:Connect(function()
            if textConn and textConn.Connected then textConn:Disconnect() end
            if attrConn and attrConn.Connected then attrConn:Disconnect() end
        end)
    end)
end

local function bindPlayerGuiPopups(playerGui)
    if not (playerGui and playerGui:IsA("PlayerGui")) then return end

    local descendants = playerGui:GetDescendants()
    for i = 1, #descendants do
        local d = descendants[i]
        if d.Name == "Body" then
