local function updatePlayerESP()
    if not Settings.ESPEnabled then
        for _, data in pairs(PlayerESPObjects) do
            if data.Billboard and data.Billboard.Enabled then
                data.Billboard.Enabled = false
            end
        end
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position

    for player, data in pairs(PlayerESPObjects) do
        local char = player.Character
        local root = data.RootPart
        local hum = data.Humanoid
        local bb = data.Billboard

        if not (char and char.Parent and root and root.Parent and hum and hum.Parent and hum.Health > 0) then
            if bb and bb.Enabled then
                bb.Enabled = false
            end
        else
            if bb and not bb.Enabled then
                bb.Enabled = true
            end

            -- Team Color & Team Name Resolution
            local team = player.Team
            local teamColor = (team and team.TeamColor and team.TeamColor.Color) or Color3.fromRGB(240, 240, 240)
            local teamHex = string.format("#%02X%02X%02X", math.floor(teamColor.R * 255), math.floor(teamColor.G * 255), math.floor(teamColor.B * 255))
            local teamName = team and team.Name or "No Team"
            local playerName = player.DisplayName or player.Name

            -- Build Main Line: [HOSTILE] [Team] Name | Distance | HP (with dedicated colors)
            local mainLineParts = {}

            if Settings.ESPShowHostile then
                local isPatient = (teamName == "PATIENT" or teamName == "PATIENTS")
                local isTagged = player:GetAttribute("IsTagged")
                if isTagged == nil and char then
                    isTagged = char:GetAttribute("IsTagged")
                end
                if isPatient and isTagged == true then
                    table.insert(mainLineParts, '<font color="#990000"><b>[HOSTILE]</b></font>')
                end
            end

            if Settings.ESPShowTeam then
                table.insert(mainLineParts, string.format('<font color="%s">[%s]</font>', teamHex, teamName))
            end
            if Settings.ESPShowName then
                table.insert(mainLineParts, string.format('<font color="%s">%s</font>', teamHex, playerName))
            end

            if Settings.ESPShowLevel then
                local lvl = player:GetAttribute("CurrentTeamLevel")
                if lvl == nil and char then
                    lvl = char:GetAttribute("CurrentTeamLevel")
                end
                if lvl ~= nil then
                    local lvlStr = string.format('<font color="#fbbf24">Lvl %s</font>', tostring(lvl))
                    if #mainLineParts > 0 then
                        table.insert(mainLineParts, string.format('<font color="#94a3b8">|</font> %s', lvlStr))
                    else
                        table.insert(mainLineParts, lvlStr)
                    end
                end
            end

            if Settings.ESPShowDistance and myPos then
                local dist = math.round((root.Position - myPos).Magnitude)
                local distStr = string.format('<font color="#38bdf8">%dm</font>', dist)
                if #mainLineParts > 0 then
                    table.insert(mainLineParts, string.format('<font color="#94a3b8">|</font> %s', distStr))
                else
                    table.insert(mainLineParts, distStr)
                end
            end

            if Settings.ESPShowHealth then
                local hp = math.max(0, math.round(hum.Health))
                local maxHp = math.max(1, math.round(hum.MaxHealth))
                local hpColor = (hp > (maxHp * 0.5)) and "#4ade80" or ((hp > (maxHp * 0.25)) and "#facc15" or "#f87171")
                local hpStr = string.format('<font color="%s">%d HP</font>', hpColor, hp)
                if #mainLineParts > 0 then
                    table.insert(mainLineParts, string.format('<font color="#94a3b8">|</font> %s', hpStr))
                else
                    table.insert(mainLineParts, hpStr)
                end
            end

            data.NameLabel.Text = table.concat(mainLineParts, " ")
            data.InfoLabel.Text = ""
        end
    end
end

