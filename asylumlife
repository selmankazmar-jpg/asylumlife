local FOLDER_NAME = "AsylumLife_Configs"
local AUTOLOAD_FILE = FOLDER_NAME .. "/autoload.txt"
local hasFileSystem = (typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfolder) == "function" and typeof(makefolder) == "function")

local function initFileSystem()
    if hasFileSystem then
        pcall(function()
            if not isfolder(FOLDER_NAME) then
                makefolder(FOLDER_NAME)
            end
        end)
    end
end

local function getAutoloadConfig()
    if not hasFileSystem then return nil end
    local ok, res = pcall(function()
        if typeof(isfile) == "function" and isfile(AUTOLOAD_FILE) then
            local str = readfile(AUTOLOAD_FILE)
            if str then
                str = string.gsub(str, "%s+", "")
                if #str > 0 then return str end
            end
        end
        return nil
    end)
    return ok and res or nil
end

local function setAutoloadConfig(name)
    if not hasFileSystem then return false end
    return pcall(function()
        initFileSystem()
        if name and #name > 0 then
            writefile(AUTOLOAD_FILE, name)
        else
            if typeof(delfile) == "function" and typeof(isfile) == "function" and isfile(AUTOLOAD_FILE) then
                delfile(AUTOLOAD_FILE)
            end
        end
    end)
end

local function getSavedConfigList()
    local list = {}
    if not hasFileSystem or typeof(listfiles) ~= "function" then return list end
    pcall(function()
        initFileSystem()
        local files = listfiles(FOLDER_NAME)
        for _, file in ipairs(files) do
            local clean = string.gsub(file, "\\", "/")
            local name = string.match(clean, "([^/]+)%.json$")
            if name then
                table.insert(list, name)
            end
        end
    end)
    table.sort(list)
    return list
end

