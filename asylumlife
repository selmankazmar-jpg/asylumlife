local cam = Workspace.CurrentCamera
if cam then
    cameraResizeConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        task.spawn(applyResponsiveMainFrameSize)
    end)
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if cameraResizeConn and cameraResizeConn.Connected then
