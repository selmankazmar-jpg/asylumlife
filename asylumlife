local function copyToClipboard(text, btn, stroke)
    pcall(function()
        if typeof(setclipboard) == "function" then
            setclipboard(text)
        elseif typeof(toclipboard) == "function" then
            toclipboard(text)
        elseif typeof(write_clipboard) == "function" then
            write_clipboard(text)
        elseif typeof(set_clipboard) == "function" then
            set_clipboard(text)
        end
    end)
    btn.Text = "✓ Copied!"
    btn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
    if stroke then stroke.Color = Color3.fromRGB(74, 222, 128) end
    task.delay(2, function()
